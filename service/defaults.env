# 默认值兜底：/etc/passport-bili/env 里没写的键由这里补
# 优先级：进程环境变量 > 用户配置文件 env > 本文件
# （systemd 里两个 EnvironmentFile 按顺序加载，后一个覆盖前一个，所以用户配置在后）
TV_BIND=0.0.0.0
TV_PORT=10745
TV_QUALITY=standard
TV_MAX_SESSIONS=2
TV_STATE_DIR=state

# 帧率与压缩：这两个是实测值，不是保守默认。C3 解码能力有限，
# 12fps 起步最稳；网络和机器都好的话可以试 15。
TV_FPS=12
TV_ZLIB_LEVEL=3

# 下发音频。设为 0 会让设备卡在"正在打开频道"的彩条上——固件要等音频
# 时钟建立才开画。要静音请在设备上用播放设置里的「静音」。
TV_AUDIO=1
